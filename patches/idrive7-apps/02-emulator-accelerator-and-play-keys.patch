+/* ---------------- keys for a game played with the knob and the accelerator ---------------- */
+// A / D held: the knob turns left / right, click after click. W held: the accelerator goes down (the Pedal signal,
+// Manual mode); let go, it comes back up.
+const play = { keys: new Set(), timer: null, t: 0, turn: 0 };
+const PLAY_KEYS = { a: 'left', d: 'right', w: 'pedal' };
+const TURN_RATE = 22, PEDAL_RATE = 320, PEDAL_BACK = 480;    // clicks / s, % / s
+function playTick() {
+  const now = performance.now(), dt = Math.min(0.1, (now - play.t) / 1000);
+  play.t = now;
+  const dir = (play.keys.has('right') ? 1 : 0) - (play.keys.has('left') ? 1 : 0);
+  if (dir) { play.turn += dir * TURN_RATE * dt; const n = Math.trunc(play.turn); if (n) { play.turn -= n; send({ t: 'ccu', turn: n }); } } else play.turn = 0;
+  const p = play.keys.has('pedal') ? Math.min(100, sig.v.pedal + PEDAL_RATE * dt) : Math.max(0, sig.v.pedal - PEDAL_BACK * dt);
+  if (Math.round(p) !== sig.v.pedal || play.keys.has('pedal')) {
+    sig.v.pedal = Math.round(p);
+    const r = $('#sig-pedal'); if (r) { r.value = sig.v.pedal; r._show(); }
+    manual();
+  }
+  if (!play.keys.size && !sig.v.pedal) { clearInterval(play.timer); play.timer = null; }
+}
+document.addEventListener('keydown', (e) => {
+  const k = PLAY_KEYS[String(e.key).toLowerCase()];
+  if (!k || typing(e) || S.closed) return;
+  e.preventDefault();
+  if (play.keys.has(k)) return;
+  play.keys.add(k);
+  if (k !== 'pedal') send({ t: 'ccu', turn: k === 'right' ? 1 : -1 });      // (a tap is one click)
+  if (!play.timer) { play.t = performance.now(); play.timer = setInterval(playTick, 33); }
+});
+document.addEventListener('keyup', (e) => { const k = PLAY_KEYS[String(e.key).toLowerCase()]; if (k) play.keys.delete(k); });
+window.addEventListener('blur', () => play.keys.clear());
+
